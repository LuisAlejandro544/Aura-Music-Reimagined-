<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo adaptativo vectorial (108dp) para Aura Music.
     Utiliza un degradado radial oscuro y halos sutiles centrados en (54,54) para adaptarse
     sin cortes a cualquier forma de icono configurada por el usuario (circular, squircle, cuadrada). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="68">
                <item android:offset="0.0" android:color="#2B1F54" />
                <item android:offset="0.52" android:color="#151028" />
                <item android:offset="1.0" android:color="#09070F" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Anillos ambientales sutiles para dar profundidad en mascaras anchas -->
    <path
        android:pathData="M54,8 A46,46 0 1,0 54,100 A46,46 0 1,0 54,8 Z"
        android:strokeWidth="0.8"
        android:strokeColor="#8B5CF6"
        android:strokeAlpha="0.08" />
    <path
        android:pathData="M54,16 A38,38 0 1,0 54,92 A38,38 0 1,0 54,16 Z"
        android:strokeWidth="0.9"
        android:strokeColor="#A78BFA"
        android:strokeAlpha="0.12" />

    <!-- Resplandor aura detras del disco -->
    <path android:pathData="M54,22 A32,32 0 1,0 54,86 A32,32 0 1,0 54,22 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="32">
                <item android:offset="0.0" android:color="#578B5CF6" />
                <item android:offset="0.65" android:color="#1A38BDF8" />
                <item android:offset="1.0" android:color="#0009070F" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
